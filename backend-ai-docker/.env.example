# =============================================================================
# 3D MECH AR CHESS - BACKEND ENVIRONMENT CONFIGURATION (SUPABASE POSTGRESQL)
# =============================================================================
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR SENSITIVE PASSWORDS TO VERSION CONTROL!
# Copy this file to `.env` in `backend-ai-docker/` and replace placeholders with your actual values.
# =============================================================================

# Server Environment
APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONNECTION
# -----------------------------------------------------------------------------
# You can find your connection string in Supabase Dashboard:
# Project Settings -> Database -> Connection string -> URI / Connection pooling
#
# Option A: Supabase Connection Pooler (Recommended for Serverless / Cloud deploy)
# Mode: Transaction (Port 6543) or Session (Port 5432)
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option B: Direct Connection (IPv6 enabled or local dev)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Option C: Local Dev Fallback (If left blank, system falls back to local async SQLite):
# DATABASE_URL=
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_secure_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Supabase Auth / Project Settings (Optional, for client-side Supabase SDK integration)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# DO NOT EXPOSE SERVICE_ROLE_KEY TO CLIENTS!
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION HARDENING
# -----------------------------------------------------------------------------
# Secure secret key for signing player JWT tokens and match verification tickets.
# Generate a strong 64-character random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated URLs, do not use '*' in production with credentials)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000

# Max HTTP Request Body Size in bytes (default 10MB)
MAX_PAYLOAD_SIZE_BYTES=10485760
